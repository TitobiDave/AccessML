# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./accessml.db
CORS_ORIGINS=["http://localhost:5173"]

# AI tutor (Groq). Key stays on the server, never in the frontend.
GROQ_API_KEY=
GROQ_MODEL=qwen-2.5-coder-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Quiz / certificate rules
QUIZ_PASS_RATIO=0.7
REQUIRE_COMPLETION_FOR_CERTIFICATE=false
COURSE_TITLE=Supervised Machine Learning & Python Foundations